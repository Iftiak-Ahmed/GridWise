# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM providers (Groq required, Gemini optional secondary) ---
# Groq is tried first. Get a free key (no card required) at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# If the Groq call fails (rate limit, timeout, outage), Gemini is tried next before falling
# back to the deterministic heuristic — this keeps a real LLM on the interpretation path
# through a single-provider outage. Optional: leave blank to run with Groq only. Get a free
# key (no card required) at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Per-provider timeout budgets (seconds). Groq (LPU inference) is typically sub-2s; Gemini
# flash-lite is typically 5-15s. Kept so even a Groq-timeout-then-Gemini-attempt sequence
# (worst case 5 + 15 = 20s) still lands comfortably under the 30s per-request judge timeout.
GROQ_TIMEOUT_SECONDS=5
GEMINI_TIMEOUT_SECONDS=15

# --- Service ---
# Port the HTTP server binds to. The Docker image also exposes this port.
PORT=8000
