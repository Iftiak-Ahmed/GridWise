# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM provider (required) ---
# Groq API key used to interpret operator_notes. Get one free (no card required) at
# https://console.groq.com/keys
GROQ_API_KEY=

# Model used for operator-note interpretation. GPT-OSS 120B on Groq's LPU inference is fast
# enough to keep p95 latency low while still handling paraphrased natural-language directives
# reliably.
GROQ_MODEL=openai/gpt-oss-120b

# Per-call timeout budget (seconds) for the LLM request. Kept well under the 30s per-request
# judge timeout so a slow/unavailable provider still leaves time for the deterministic fallback
# and the optimizer to run and respond.
LLM_TIMEOUT_SECONDS=12

# --- Service ---
# Port the HTTP server binds to. The Docker image also exposes this port.
PORT=8000
